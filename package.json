{
  "name": "windease",
  "version": "2.2.0",
  "description": "Browser window/zone/workspace model with pluggable layout strategies, opt-in drag-and-drop, snapshot persistence — headless core and React bindings in one package.",
  "keywords": [
    "windease",
    "window-manager",
    "layout",
    "tiling",
    "binary-split",
    "drag-and-drop",
    "react"
  ],
  "license": "MIT",
  "author": "Michael Baker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/windease.git"
  },
  "homepage": "https://github.com/orochi235/windease#readme",
  "bugs": "https://github.com/orochi235/windease/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuts": {
      "types": "./dist/nuts/index.d.ts",
      "import": "./dist/nuts/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -b tsconfig.build.json && cp src/react/styles.css dist/react/styles.css",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json && tsc -p dev/pack-lab/tsconfig.json && tsc -p dev/pack-lab/sweep/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "dev:pack-lab": "vite dev/pack-lab",
    "pack:sweep": "tsx --tsconfig dev/pack-lab/sweep/tsconfig.json dev/pack-lab/sweep/sweep.ts",
    "docs:api": "npx --yes -p typedoc@0.28.20 -p typescript@6.0.3 typedoc",
    "prepare": "scripts/strip-ladle-tsx.sh",
    "prepublishOnly": "npm run build",
    "postversion": "git push --follow-tags",
    "test:all": "npm test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@weasel-js/animator": "1.13.0",
    "@weasel-js/core": "1.13.0",
    "@weasel-js/font": "1.13.0",
    "@weasel-js/labkit": "1.13.0",
    "@weasel-js/theme": "1.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@ladle/react": {
      "@vitejs/plugin-react": "$@vitejs/plugin-react"
    }
  }
}
