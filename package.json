{
  "name": "windease",
  "version": "1.1.0",
  "description": "Browser window/zone/workspace model with pluggable layout strategies, opt-in drag-and-drop, snapshot persistence — headless core and React bindings in one package.",
  "keywords": [
    "windease",
    "window-manager",
    "layout",
    "tiling",
    "binary-split",
    "drag-and-drop",
    "react"
  ],
  "license": "MIT",
  "author": "Michael Baker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/windease.git"
  },
  "homepage": "https://github.com/orochi235/windease#readme",
  "bugs": "https://github.com/orochi235/windease/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -b tsconfig.build.json && cp src/react/styles.css dist/react/styles.css",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "docs:api": "typedoc",
    "prepublishOnly": "npm run build",
    "postversion": "git push --follow-tags",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
