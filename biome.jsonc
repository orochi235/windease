{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/*.tsbuildinfo",
      "!**/docs-api",
      "!**/build",
      "!**/.ladle",
      "!**/test-results",
      "!**/playwright-report",
      "!**/blob-report",
      "!**/.superpowers",
      "!**/.playwright-mcp",
      // Written by astv's capture script; a recapture would undo any reformatting.
      "!dev/pack-lab/datasets",
      // Local tool output, all of it gitignored: astv's cache, semanticore's
      // dumps, and what scripts/flake-census.mjs writes.
      "!.astv",
      "!.semanticore",
      "!flake-census.json",
      // Root-anchored: "!**/.claude" would match the .claude segment of an
      // absolute path and exclude everything when run from inside a worktree.
      "!.claude"
    ]
  },
  "plugins": ["./scripts/expect-in-listener.grit"],
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "suspicious": {
        "noExplicitAny": "warn",
        // Stateless strategies model "no layout state" as `state: void`
        // (LayoutStrategy<void>); `void` in those type positions is idiomatic
        // here, and biome's suggested `undefined` rewrite changes the typing.
        "noConfusingVoidType": "off"
      },
      "performance": {
        // The store/snapshot code removes optional keys with `delete` so the
        // property is genuinely absent (honoring optional shapes / dropping
        // migrated legacy fields); assigning `undefined` would leave the key.
        "noDelete": "off"
      }
    }
  },
  // Its formatter rewraps the code samples in the docs and adds semicolons to
  // JSX fragments in them.
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      // A test renders its component once, so one defined inside the test is
      // never remounted by a re-rendering parent.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "correctness": { "noComponentHookFactories": "off" } } }
    },
    {
      // Vitest takes an async describe, and config-check has a function of its
      // own called describe.
      "includes": ["src/**"],
      "linter": { "rules": { "correctness": { "usePlaywrightValidDescribeCallback": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } }
}
